  "checks": [
    {
      "id": "C01",
      "name": "交付规格",
      "mode": "deterministic",
      "fields": [
        "body_han_count",
        "body_non_whitespace_count",
        "explicit_chapter_count"
      ],
      "limits_require_explicit_applicability": true,
      "sources": [
        {
          "path": "source-snapshots/public-check-rules.md",
          "sha256": "6808b54207722328ae65c0f7b49c1e5c1917ae20eb19dfcb45e003c57e92598f",
          "bytes": 2810,
          "start_line": 7,
          "end_line": 9,
          "text": "## C01 交付规格\n\n只计量正文汉字、非空白字符和明确章数，书名和章名不计入正文。篇幅上下限、计数口径及章数要求必须由本次输入明确提供；缺省不推断平台规则，不套用历史作品预算。计数与满足已声明规格不等于文学质量合格。",
          "origin_path": "source-snapshots/public-check-rules.md"
        }
      ],
      "not_implemented": [
        "导读比例",
        "免费比例",
        "平台规范推断"
      ]
    },
    {
      "id": "C02",
      "name": "开篇三问",
      "mode": "semantic_diagnostic",
      "window": {
        "body_non_whitespace_characters": 300
      },
      "questions": [
        "主要行动者是谁",
        "眼前发生什么",
        "当下目标或风险是什么"
      ],
      "sources": [
        {
          "path": "source-snapshots/public-check-rules.md",
          "sha256": "6808b54207722328ae65c0f7b49c1e5c1917ae20eb19dfcb45e003c57e92598f",
          "bytes": 2810,
          "start_line": 11,
          "end_line": 13,
          "text": "## C02 开篇三问\n\n只据正文前 300 个非空白字符的指定窗口回答：主要行动者是谁、眼前发生什么、当下目标或风险是什么。窗口外解释不能补入；无法回答时记录证据不足。第一人称没有姓名并不自动构成问题。每个非空答案须有窗口内逐字引文。",
          "origin_path": "source-snapshots/public-check-rules.md"
        }
      ],
      "rule_origin": "public_c01_c06_rules",
      "main_task_equivalence": false,
      "note": "三问仅是指定开篇窗口内的有限诊断，不代表完整全文质量验收；窗口外答案不能补入。"
    },
    {
      "id": "C03",
      "name": "明确知情矛盾",
      "mode": "semantic_diagnostic",
      "sources": [
        {
          "path": "source-snapshots/public-check-rules.md",
          "sha256": "6808b54207722328ae65c0f7b49c1e5c1917ae20eb19dfcb45e003c57e92598f",
          "bytes": 2810,
          "start_line": 15,
          "end_line": 17,
          "text": "## C03 明确知情矛盾\n\n仅报告同一人物、同一事实、可对应时点的两个明确陈述之间的冲突。必须核对时间顺序和替代解释。叙述者知情不等于人物知情；明确回忆、谎言、转述、失忆解释或时间不明，不得当作确定矛盾。两个证据端来自同稿且互不重叠。",
          "origin_path": "source-snapshots/public-check-rules.md"
        }
      ],
      "required_evidence": [
        "same_character",
        "same_fact",
        "two_explicit_statements",
        "time_order",
        "alternative_explanations"
      ],
      "must_not_flag": [
        "仅叙述者知情",
        "明确回忆",
        "明确谎言/转述",
        "失忆解释",
        "时间不明"
      ]
    },
    {
      "id": "C04",
      "name": "明确物件状态矛盾",
      "mode": "semantic_diagnostic",
      "sources": [
        {
          "path": "source-snapshots/public-check-rules.md",
          "sha256": "6808b54207722328ae65c0f7b49c1e5c1917ae20eb19dfcb45e003c57e92598f",
          "bytes": 2810,
          "start_line": 19,
          "end_line": 21,
          "text": "## C04 明确物件状态矛盾\n\n仅报告同一独特物件在可对应时点的两个明确互斥状态。核对转交、复制、修复及其他解释。省略转移过程、同名不同物件、已解释的状态变化或时点无法对应，不足以认定矛盾。两个证据端来自同稿且互不重叠。",
          "origin_path": "source-snapshots/public-check-rules.md"
        }
      ],
      "required_evidence": [
        "same_unique_object",
        "two_explicit_incompatible_states",
        "time_order",
        "transfers_or_repairs"
      ],
      "must_not_flag": [
        "仅省略转移",
        "同名不同物件",
        "已解释转交/修复",
        "时点无法对应"
      ]
    },
    {
      "id": "C05",
      "name": "四五章承接",
      "mode": "semantic_diagnostic",
      "requires_explicit_applicability": true,
      "window": {
        "chapter_4_suffix_non_whitespace": 600,
        "chapter_5_prefix_non_whitespace": 600
      },
      "fields": [
        "action_done_in_ch4",
        "pending_result_or_cost",
        "actual_ch5_continuation",
        "evidence_for_mapping"
      ],
      "sources": [
        {
          "path": "source-snapshots/public-check-rules.md",
          "sha256": "6808b54207722328ae65c0f7b49c1e5c1917ae20eb19dfcb45e003c57e92598f",
          "bytes": 2810,
          "start_line": 23,
          "end_line": 25,
          "text": "## C05 四五章承接\n\n仅在输入明确声明第四章推广或付费切口适用时执行，默认不适用。读取第四章末 600 个非空白字符与第五章首 600 个非空白字符，分别记录已发生动作、待兑现结果或代价、第五章实际承接及对应证据。不推断真实付费位置、点击率，也不将此项视为完整情绪或文学效果评估。",
          "origin_path": "source-snapshots/public-check-rules.md"
        }
      ],
      "must_not_claim": [
        "实际付费点",
        "点击率",
        "完整情绪/容量审计"
      ]
    },
    {
      "id": "C06",
      "name": "字面重合",
      "mode": "deterministic",
      "ngram_size": 12,
      "candidate_limit": 50,
      "display_match_limit": 5,
      "exclude_self_and_same_sha": true,
      "sources": [
        {
          "path": "source-snapshots/public-check-rules.md",
          "sha256": "6808b54207722328ae65c0f7b49c1e5c1917ae20eb19dfcb45e003c57e92598f",
          "bytes": 2810,
          "start_line": 27,
          "end_line": 29,
          "text": "## C06 有限字面重合\n\n只比较本次明确提供且获准使用的参考文本；排除自身路径与相同内容哈希。按当前实现规范化后采用 12 字片段、至多 50 个候选及至多 5 处展示，并保留两侧原文位置。没有参考时标记未评估，不声称全库覆盖。字面重合不是法律抄袭或结构同质化判定。",
          "origin_path": "source-snapshots/public-check-rules.md"
        }
      ],
      "must_not_claim": [
        "法律抄袭",
        "结构同质化",
        "全库覆盖"
      ]
    }
  ],
