# 本机模型配置示例。复制为 .env.local 后填写，密钥仅由后台读取。
# DeepSeek 示例；兼容 Chat Completions 的其他服务可修改地址和模型名。
TALEWICK_API_BASE_URL=https://api.deepseek.com
TALEWICK_MODEL=deepseek-v4-flash
TALEWICK_API_KEY=
TALEWICK_PORT=4326
# 单次模型调用的总上限；DeepSeek V4 长篇规划/写作包含推理时间。
TALEWICK_MODEL_TIMEOUT_MS=600000
# V4 业务流超过此时间没有非空正文或推理增量时停止；空行/保活不算生成进展。
TALEWICK_MODEL_IDLE_TIMEOUT_MS=180000
# 新任务默认使用 AI SDK ToolLoopAgent；设为 fixed 后重启，只影响后续新任务。
TALEWICK_ENGINE=ai-sdk
# Agent 提供商适配默认按地址选择：api.deepseek.com 使用 deepseek，其他地址使用 openai-compatible。
# TALEWICK_AGENT_PROVIDER=openai-compatible
# 可选：任务保存目录，默认本目录下 .local-runs。
# TALEWICK_RUNS_DIR=
